{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/((?!@vite/|@react-refresh|src/|node_modules/|favicon\\.svg$|.*\\.[a-zA-Z0-9]+$).*)",
      "dest": "/index.html"
    }
  ]
}
